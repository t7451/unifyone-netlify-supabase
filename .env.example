# ─────────────────────────────────────────────────────────────────────────────
# UnifyOne — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────

# Canonical public URL of the app (no trailing slash).
# Netlify sets URL automatically; override here for custom domains.
PUBLIC_APP_URL=https://your-domain.com

# Internal app identifier embedded in JWTs. Defaults to "unifyone".
VITE_APP_ID=unifyone

NODE_ENV=development

# ── Auth / JWT ────────────────────────────────────────────────────────────────

# REQUIRED. Secret used to sign app session JWTs (HS256).
# Must be at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# openId of the user who should be granted admin role automatically.
# Run `SELECT "openId" FROM users WHERE email = 'you@example.com';` to find it.
OWNER_OPEN_ID=

# ── Cookie ────────────────────────────────────────────────────────────────────

# Restrict the session cookie to your root domain and first-party subdomains.
# Use a leading dot to include subdomains: .your-domain.com
# Leave empty in local development (cookie scopes to localhost automatically).
COOKIE_DOMAIN=

# ── Database ──────────────────────────────────────────────────────────────────

# REQUIRED. PostgreSQL connection string (Neon serverless recommended).
# Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# ── Email (Resend) ────────────────────────────────────────────────────────────

# Used for password reset, email verification, and drip campaigns.
# Get your key at https://resend.com
RESEND_API_KEY=

# ── Supabase (optional — only needed for Supabase OAuth / magic link / Realtime) ──

SUPABASE_URL=
VITE_SUPABASE_URL=
# REQUIRED for Supabase auth and Realtime (used by client/src/lib/supabaseClient.ts)
VITE_SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe ────────────────────────────────────────────────────────────────────

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── PayPal ────────────────────────────────────────────────────────────────────

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# ── Square ────────────────────────────────────────────────────────────────────

SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_WEBHOOK_SIGNATURE_KEY=
# sandbox | production
SQUARE_ENVIRONMENT=production

# ── Clerk (optional fallback auth provider) ───────────────────────────────────

CLERK_SECRET_KEY=

# ── Firebase (optional fallback auth provider) ────────────────────────────────

FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=

# ── Forge / MCP (optional) ────────────────────────────────────────────────────

# API key and base URL for the built-in LLM/Forge service.
# Used by server/_core/llm.ts (assertApiKey) and AI-powered features such as
# the claudeGovernance router's evaluateAutonomousAction procedure.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# ── Upstash Redis (recommended for production rate limiting) ──────────────────

# When set, authRateLimiter and passwordResetLimiter use a distributed
# Upstash Redis sliding-window counter instead of the in-process in-memory
# store. This is required for correct rate limiting on Netlify Functions
# (serverless / multi-instance) where each invocation is a fresh process.
# Create a database at https://console.upstash.com and copy the REST URL/token.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Internal API ──────────────────────────────────────────────────────────────

ADMIN_API_KEY=

# ── Error Tracking (Sentry) ──────────────────────────────────────────────────

# Optional. Set to enable error tracking in production.
# Get your DSN from https://sentry.io → Project Settings → Client Keys
SENTRY_DSN=
