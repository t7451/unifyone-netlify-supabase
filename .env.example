# ─────────────────────────────────────────────────────────────────────────────
# UnifyOne — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────

# Canonical public URL of the app (no trailing slash).
# This is the preferred explicit value for redirects, email links, and webhooks.
PUBLIC_APP_URL=https://app.example.com

# Netlify/hosting URL fallbacks used when PUBLIC_APP_URL is not set.
# APP_URL is commonly used for branch aliases or custom platform config.
APP_URL=https://branch-alias.example.com
# Netlify primary site URL.
URL=https://site-name.netlify.app
# Netlify deploy preview URL.
DEPLOY_PRIME_URL=https://deploy-preview-123--site-name.netlify.app
# Additional deploy URL fallback used by ENV.appBaseUrl.
DEPLOY_URL=https://deploy-context.example.com

# Internal app identifier embedded in JWTs. Defaults to "unifyone".
VITE_APP_ID=unifyone

# Runtime mode: development | production | test
NODE_ENV=development

# ── Auth / JWT ────────────────────────────────────────────────────────────────

# REQUIRED. Secret used to sign app session JWTs (HS256).
# Must be at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=YOUR_JWT_SECRET_MIN_32_CHARS_HERE

# openId of the user who should be granted admin role automatically.
# Run `SELECT "openId" FROM users WHERE email = 'you@example.com';` to find it.
OWNER_OPEN_ID=

# ── Cookie ────────────────────────────────────────────────────────────────────

# REQUIRED IN PRODUCTION. Restrict the session cookie to your root domain and
# first-party subdomains. Use a leading dot to include subdomains:
#   COOKIE_DOMAIN=.your-domain.com
# In local development leave empty — the cookie scopes to localhost.
# The startup validator REFUSES TO BOOT in production with this unset, because
# auto-deriving the domain from the request hostname leaks the cookie across
# Netlify deploy preview branches.
COOKIE_DOMAIN=

# ── CORS / CSRF ───────────────────────────────────────────────────────────────

# Comma-separated list of origins allowed to make credentialed requests to
# the API. PUBLIC_APP_URL is automatically appended. The same list is used
# by both the CORS middleware and the CSRF Origin/Referer check, so any
# first-party admin / marketing surface that posts to the API must be listed.
# Example: CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
CORS_ALLOWED_ORIGINS=

# ── PayPal ────────────────────────────────────────────────────────────────────

# REQUIRED IN PRODUCTION (when PayPal is enabled). Webhook ID from the PayPal
# developer dashboard. Used by /api/paypal/webhook to verify deliveries via
# /v1/notifications/verify-webhook-signature. Without this, the receiver
# fails closed and rejects every webhook.
PAYPAL_WEBHOOK_ID=

# ── n8n ───────────────────────────────────────────────────────────────────────

# Shared secret for HMAC-SHA256 verification of inbound n8n webhooks at
# /api/n8n/webhook. Configure n8n to send the matching X-N8N-Signature
# header (sha256=<hex digest of body>). Required if n8n integration is used.
N8N_WEBHOOK_SECRET=

# ── Database ──────────────────────────────────────────────────────────────────

# REQUIRED. PostgreSQL connection string (Neon serverless recommended).
# Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Netlify Postgres connection string (set automatically by Netlify if using
# the Netlify Postgres add-on; takes precedence over DATABASE_URL in that context).
NETLIFY_DATABASE_URL=
NETLIFY_DATABASE_URL_UNPOOLED=

# ── Email (Resend) ────────────────────────────────────────────────────────────

# OPTIONAL. Used for password reset, email verification, and drip campaigns.
# If not set, email verification is skipped (users are auto-verified on signup).
# Get your key at https://resend.com
RESEND_API_KEY=re_YOUR_RESEND_API_KEY_HERE

# Webhook URL to receive contact form submissions (Slack / n8n / Zapier).
# Leave empty to log submissions server-side only.
CONTACT_WEBHOOK_URL=

# ── Supabase (OPTIONAL — only needed for Realtime push notifications) ─────────
# The app's login flow uses custom JWT auth (email/password) by default.
# Supabase is NOT required for authentication — it's only used for optional
# real-time features (live updates, presence). If these are not set, the app
# gracefully degrades to polling mode.

SUPABASE_URL=https://your-project-id.supabase.co
# VITE_SUPABASE_URL must equal SUPABASE_URL (needed by the Vite client build)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
# Anon (public) key — safe to expose to the browser
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY_HERE
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY_HERE
# Service role key — server-side only, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY_HERE
# JWT secret from Supabase project settings → API → JWT Secret
SUPABASE_JWT_SECRET=YOUR_SUPABASE_JWT_SECRET_HERE

# ── Stripe ────────────────────────────────────────────────────────────────────

STRIPE_SECRET_KEY=sk_live_YOUR_STRIPE_SECRET_KEY_HERE
STRIPE_WEBHOOK_SECRET=whsec_YOUR_STRIPE_WEBHOOK_SECRET_HERE
# Public key — exposed to the browser via Vite (safe to share)
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_YOUR_STRIPE_PUBLISHABLE_KEY_HERE

# ── PayPal ────────────────────────────────────────────────────────────────────

PAYPAL_CLIENT_ID=YOUR_PAYPAL_CLIENT_ID_HERE
PAYPAL_CLIENT_SECRET=YOUR_PAYPAL_CLIENT_SECRET_HERE
# Must match PAYPAL_CLIENT_ID (exposed to browser for PayPal Smart Buttons)
VITE_PAYPAL_CLIENT_ID=YOUR_PAYPAL_CLIENT_ID_HERE
# Optional: override the API base. Defaults to https://api-m.paypal.com (live).
# For sandbox, set to https://api-m.sandbox.paypal.com.
PAYPAL_API_BASE_URL=https://api-m.paypal.com

# ── Square ────────────────────────────────────────────────────────────────────

SQUARE_ACCESS_TOKEN=YOUR_SQUARE_ACCESS_TOKEN_HERE
SQUARE_LOCATION_ID=YOUR_SQUARE_LOCATION_ID_HERE
SQUARE_WEBHOOK_SIGNATURE_KEY=YOUR_SQUARE_WEBHOOK_SIGNATURE_KEY_HERE
# sandbox | production
SQUARE_ENVIRONMENT=production
# REQUIRED IN PRODUCTION. Exact URL Square POSTs to and signs against.
# Setting this defends against host-header injection on the webhook receiver.
# Match the URL configured in the Square Developer Dashboard exactly.
SQUARE_WEBHOOK_NOTIFICATION_URL=https://1commerce.online/api/square/webhook

# ── Payment fallback routing ───────────────────────────────────────────────────

# Subscription checkout tries providers in this order. Stripe is best for
# recurring subscriptions; Square/PayPal collect the first period as hosted
# one-time fallbacks; manual routes to contact/invoice intake.
PAYMENT_PROVIDER_ORDER=stripe,square,paypal,manual
# Comma-separated emergency kill switch, e.g. stripe,paypal
PAYMENT_PROVIDER_DISABLED=
# Set false only if you do not want manual invoice fallback as the final rail.
MANUAL_PAYMENTS_ENABLED=true
# Optional: external/manual invoice URL. Defaults to PUBLIC_APP_URL/contact.
MANUAL_PAYMENT_URL=
# Optional hosted Shopify checkout/product URL for Shopify fallback.
SHOPIFY_CHECKOUT_URL=

# ── Shopify ───────────────────────────────────────────────────────────────────

SHOPIFY_API_KEY=YOUR_SHOPIFY_API_KEY_HERE
SHOPIFY_API_SECRET=YOUR_SHOPIFY_API_SECRET_HERE
# AES-256-GCM key for token encryption at rest. Generate: openssl rand -hex 32
# Rotation: set SHOPIFY_TOKEN_ENC_KEY_V2, deploy, re-encrypt, drop V1.
SHOPIFY_TOKEN_ENC_KEY=

# ── Meta (Facebook) Pixel & Conversions API ───────────────────────────────────

META_PIXEL_ID=YOUR_META_PIXEL_ID_HERE
# Must match META_PIXEL_ID (exposed to browser for client-side Pixel)
VITE_META_PIXEL_ID=YOUR_META_PIXEL_ID_HERE
META_CAPI_ACCESS_TOKEN=YOUR_META_CAPI_ACCESS_TOKEN_HERE
# Optional: Conversions API test event code (use while verifying event setup)
META_TEST_EVENT_CODE=

# ── AI / Anthropic ────────────────────────────────────────────────────────────

# OPTIONAL. Used for AI-powered features (Claude-based automation, governance).
# Get your key at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-YOUR_ANTHROPIC_API_KEY_HERE

# ── Forge / MCP (optional) ────────────────────────────────────────────────────

# API key and base URL for the built-in LLM/Forge service.
# Used by server/_core/llm.ts (assertApiKey) and AI-powered features such as
# the claudeGovernance router's evaluateAutonomousAction procedure.
BUILT_IN_FORGE_API_URL=https://your-forge-endpoint.example.com
BUILT_IN_FORGE_API_KEY=YOUR_FORGE_API_KEY_HERE

# MCP worker endpoint and authentication key (for Model Context Protocol).
MCP_WORKER_URL=https://your-mcp-worker.example.com
MCP_API_KEY=YOUR_MCP_API_KEY_HERE

# ── ngrok tunnel (optional, dev-only) ─────────────────────────────────────────
# Exposes the local UnifyOne dev server to the public internet so third-party
# webhook providers (Stripe, Shopify, PayPal, Square, n8n) and external MCP
# consumers can reach it. Use `pnpm dev:tunnel` for a one-shot start.
#
# 1. Install once:  pnpm add -D @ngrok/ngrok
# 2. Get an authtoken from https://dashboard.ngrok.com/get-started/your-authtoken
# 3. Set NGROK_ENABLED=true and NGROK_AUTHTOKEN below.
NGROK_AUTHTOKEN=
# Optional reserved domain (paid plan): e.g. unifyone-dev.ngrok.app
NGROK_DOMAIN=
NGROK_ENABLED=false
# Optional region: us | eu | ap | au | sa | jp | in
NGROK_REGION=

# Dev-only override that points Kai's MCP tool calls at a locally tunneled
# MCP worker (typically an ngrok URL fronting `wrangler dev`). Ignored in
# production. Leave blank to use MCP_WORKER_URL above.
KAI_MCP_NGROK_URL=

# ── Clerk (optional fallback auth provider) ───────────────────────────────────

CLERK_SECRET_KEY=sk_live_YOUR_CLERK_SECRET_KEY_HERE
# Public key — exposed to the browser via Vite (safe to share)
# Get both keys from https://dashboard.clerk.com → API Keys
VITE_CLERK_PUBLISHABLE_KEY=pk_live_YOUR_CLERK_PUBLISHABLE_KEY_HERE

# ── Firebase (optional fallback auth provider) ────────────────────────────────

FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY_HERE

# ── 1Commerce / UnifyOne external API ────────────────────────────────────────

# Base URL of the UnifyOne platform instance. Used by the @unifyone/mcp-server
# TypeScript SDK (src-typescript/) to proxy tool calls to the platform.
# Defaults to "https://1commerce.online" when not set.
ONECOMMERCE_API_URL=https://1commerce.online

# ── Upstash Redis (recommended for production rate limiting) ──────────────────

# When set, authRateLimiter, passwordResetLimiter, and contactLimiter use a
# distributed Upstash Redis sliding-window counter instead of the in-process
# in-memory store. This is required for correct rate limiting on Netlify
# Functions (serverless / multi-instance) where each invocation is a fresh
# process. Create a database at https://console.upstash.com and copy the
# REST URL and token.
UPSTASH_REDIS_REST_URL=https://your-upstash-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=YOUR_UPSTASH_REDIS_REST_TOKEN_HERE

# ── Voyage AI (semantic embeddings for documentChat / RAG) ────────────────────

# API key for Voyage AI (https://www.voyageai.com). Used by the documentation
# chatbot router (server/routers/documentChat.ts) and the intelligence-doc
# seeder (scripts/seed-intelligence.ts) to compute real semantic embeddings
# for retrieval. When unset, the helper transparently falls back to a
# deterministic hash-based embedding so dev / CI keep working — production
# MUST set this for meaningful similarity search.
VOYAGE_API_KEY=

# Optional model override. Defaults to voyage-3-large (Anthropic's preferred
# embeddings model). Other valid values: voyage-3, voyage-3-lite, voyage-code-3.
VOYAGE_MODEL=

# Optional output dimensionality. Defaults to 1536 to match the
# documentEmbeddings.embedding column width. Real Voyage vectors are
# automatically truncated or zero-padded to this length.
VOYAGE_EMBEDDING_DIM=


# ── Internal API ──────────────────────────────────────────────────────────────

ADMIN_API_KEY=YOUR_ADMIN_API_KEY_HERE

# ── Impact.com Affiliate Network (S2S conversion tracking) ────────────────────
# Used by server/_core/impact.ts to fire S2S conversion postbacks on
# checkout.session.completed. Click capture works without these (the cookie
# + DB row are local), but conversions are skipped with a logged warning
# until all three are set.
#
# Where to find each value (Impact partner dashboard → Settings → API):
#   IMPACT_ACCOUNT_SID  — your Mediapartner Account SID (NOT advertiser SID)
#   IMPACT_AUTH_TOKEN   — generated alongside the SID (rotate periodically)
#   IMPACT_CAMPAIGN_ID  — the program/campaign you're tracking conversions for
#
# Optional override for sandbox testing or regional endpoints:
#   IMPACT_API_BASE_URL — defaults to https://api.impact.com

IMPACT_ACCOUNT_SID=
IMPACT_AUTH_TOKEN=
IMPACT_CAMPAIGN_ID=
IMPACT_API_BASE_URL=https://api.impact.com

# ── Logging ───────────────────────────────────────────────────────────────────

# Log level: debug | info | warn | error. Defaults to "info" in production.
LOG_LEVEL=

# ── Error Tracking (Sentry) ──────────────────────────────────────────────────

# Optional. Set to enable error tracking in production.
# Get your DSN from https://sentry.io → Project Settings → Client Keys
SENTRY_DSN=

# ── Analytics ─────────────────────────────────────────────────────────────────

# Umami or custom analytics endpoint
VITE_ANALYTICS_ENDPOINT=

# ── Cloudflare Worker (1commerce-nlweb) ──────────────────────────────────────
# Base URL of the AI chat worker that powers /chat. Defaults to the production
# worker if unset.
VITE_NLWEB_WORKER_URL=https://1commerce-nlweb.skdev-371.workers.dev
