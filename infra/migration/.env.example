# Legacy Supabase Postgres — use the direct (non-pooled) connection string.
# Dashboard → Project Settings → Database → Connection String → "postgres" format.
SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres
SUPABASE_PROJECT_REF=

# New Neon Postgres (same value used by apps/unifyone/.env NEON_DATABASE_URL)
NEON_DATABASE_URL=

# Clerk backend — Production key. Dashboard → API Keys → Secret keys.
CLERK_SECRET_KEY=

# Dry run — every script respects this. Set to "false" ONLY on the real cutover run.
# When true: scripts log intent, perform zero writes against Clerk or Neon.
DRY_RUN=true

# Optional: tune Clerk bulk-import rate limit (requests per second).
# Clerk's published limit is 20 rps; leave at 15 for headroom unless support confirms higher.
CLERK_RPS=15

# Optional: filter export to a subset of Supabase tables (comma-separated, schema.public).
# Leave blank to export the entire public schema.
SUPABASE_EXPORT_TABLES=
