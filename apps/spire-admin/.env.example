# --- Core ---
NEON_DATABASE_URL=
ANTHROPIC_API_KEY=

# --- GitHub publisher ---
# Fine-grained PAT scoped to the target repo with Contents: Read/Write.
GITHUB_TOKEN=
GITHUB_OWNER=ksksrbiz-arch
# Default repo used when a spire_sites row hasn't been created yet. Site rows
# carry their own `repo` column once registered.
GITHUB_REPO=unifyone-netlify-supabase
# Default branch — bot commits go straight here.
GITHUB_BRANCH=main

# --- Digest email (optional) ---
# Leave MAILERLITE_API_KEY (or DIGEST_FROM_EMAIL) blank to skip email sends and
# log the digest instead. The digest is delivered as a MailerLite campaign, so
# DIGEST_FROM_EMAIL must be a *verified* sender on the account.
MAILERLITE_API_KEY=
DIGEST_TO_EMAIL=
DIGEST_TO_NAME=
DIGEST_FROM_EMAIL=
DIGEST_FROM_NAME=UnifyOne Spire
# Group the recipient is filed under; created on first send if absent.
DIGEST_GROUP_NAME=Spire Digest Recipients

# --- Tuning ---
# Model — override only if the account lacks Opus 4.7 access.
SPIRE_MODEL=claude-opus-4-7
# How many briefs to build per scheduled tick when the queue is thin.
SPIRE_TICK_BRIEFS_PER_RUN=5
# How many articles to generate per scheduled tick.
SPIRE_TICK_ARTICLES_PER_RUN=2
