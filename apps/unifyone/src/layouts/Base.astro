---
import "../styles/global.css";
import Nav from "../components/astro/Nav.astro";
import Footer from "../components/astro/Footer.astro";
import { buildMeta, organization, website } from "../lib/seo";
// Build-time import of the canonical business profile — one file, one NAP,
// inlined into every page's <head> as a LocalBusiness/Organization JSON-LD
// block. No runtime dep on @1commerce/spire (that workspace carries heavy
// deps like @anthropic-ai/sdk; apps/unifyone should never import it).
import businessProfile from "../../../spire-admin/config/business-profile.json";

interface Props {
  title: string;
  description: string;
  canonicalUrl: string;
  ogImage?: string;
  jsonLd?: unknown[];
  type?: "website" | "article";
}

const { title, description, canonicalUrl, ogImage, jsonLd = [], type } =
  Astro.props;

const meta = buildMeta({ title, description, canonicalUrl, ogImage, type });

// LocalBusiness / Organization JSON-LD from the canonical NAP source.
// Kept as a pure inline object to avoid pulling @1commerce/spire at build
// time — if the profile shape ever drifts, Astro's content-collection-style
// JSON import will surface the type mismatch on next `astro build`.
const primaryUrl = (businessProfile.web.primary as string).replace(/\/$/, "");
const socialLinks = Object.values(businessProfile.social).filter(
  (v): v is string => typeof v === "string" && v.length > 0,
);
const localBusinessLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: businessProfile.legal.name,
  alternateName: businessProfile.display.short_name,
  legalName: businessProfile.legal.name,
  url: primaryUrl,
  logo: `${primaryUrl}/favicon.svg`,
  address: {
    "@type": "PostalAddress",
    streetAddress: businessProfile.address.line_1,
    addressLocality: businessProfile.address.city,
    addressRegion: businessProfile.address.region,
    postalCode: businessProfile.address.postal_code,
    addressCountry: businessProfile.address.country,
  },
  contactPoint: {
    "@type": "ContactPoint",
    telephone: businessProfile.phone.e164,
    contactType: "customer service",
    email: businessProfile.email.public,
    areaServed: businessProfile.address.country,
    availableLanguage: ["English"],
  },
  foundingDate: businessProfile.founded,
  description: businessProfile.description.medium,
  sameAs: socialLinks,
};

// Always emit Organization + WebSite + the NAP LocalBusiness block;
// page-specific entries come via the jsonLd prop.
const allJsonLd = [organization(), website(), localBusinessLd, ...jsonLd];

// Escape characters that could break out of the <script> tag or terminate
// JSON in line-separator contexts. JSON.stringify alone is NOT safe here.
function serializeJsonLd(entry: unknown): string {
  const json = JSON.stringify(entry);
  if (json === undefined) return "null";
  return json
    .replace(/</g, "\\u003c")
    .replace(/\u2028/g, "\\u2028")
    .replace(/\u2029/g, "\\u2029");
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{meta.title}</title>
    {
      meta.tags.map((t) =>
        t.name ? (
          <meta name={t.name} content={t.content} />
        ) : (
          <meta property={t.property} content={t.content} />
        )
      )
    }
    {meta.links.map((l) => <link {...l} />)}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <link rel="preconnect" href="https://neon.tech" crossorigin />
    <link rel="preconnect" href="https://clerk.com" crossorigin />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
    />
    {
      allJsonLd.map((entry) => (
        <script
          type="application/ld+json"
          set:html={serializeJsonLd(entry)}
        />
      ))
    }
  </head>
  <body class="min-h-screen flex flex-col">
    <Nav />
    <main class="flex-1"><slot /></main>
    <Footer />
  </body>
</html>
