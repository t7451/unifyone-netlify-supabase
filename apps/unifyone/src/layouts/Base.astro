---
import "../styles/global.css";
import Nav from "../components/astro/Nav.astro";
import Footer from "../components/astro/Footer.astro";
import { buildMeta, organization, website } from "../lib/seo";
// Build-time import of the canonical business profile — one file, one NAP,
// inlined into every page's <head> as a LocalBusiness/Organization JSON-LD
// block. No runtime dep on @1commerce/spire (that workspace carries heavy
// deps like @anthropic-ai/sdk; apps/unifyone should never import it).
import businessProfile from "../../../spire-admin/config/business-profile.json";

interface Props {
  title: string;
  description: string;
  canonicalUrl: string;
  ogImage?: string;
  jsonLd?: unknown[];
  type?: "website" | "article";
}

const { title, description, canonicalUrl, ogImage, jsonLd = [], type } =
  Astro.props;

const meta = buildMeta({ title, description, canonicalUrl, ogImage, type });

// LocalBusiness / Organization JSON-LD from the canonical NAP source.
// Kept as a pure inline object to avoid pulling @1commerce/spire at build
// time — if the profile shape ever drifts, Astro's content-collection-style
// JSON import will surface the type mismatch on next `astro build`.
const primaryUrl = (businessProfile.web.primary as string).replace(/\/$/, "");
const socialLinks = Object.values(businessProfile.social).filter(
  (v): v is string => typeof v === "string" && v.length > 0,
);
const localBusinessLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: businessProfile.legal.name,
  alternateName: businessProfile.display.short_name,
  legalName: businessProfile.legal.name,
  url: primaryUrl,
  logo: `${primaryUrl}/favicon.svg`,
  address: {
    "@type": "PostalAddress",
    streetAddress: businessProfile.address.line_1,
    addressLocality: businessProfile.address.city,
    addressRegion: businessProfile.address.region,
    postalCode: businessProfile.address.postal_code,
    addressCountry: businessProfile.address.country,
  },
  contactPoint: {
    "@type": "ContactPoint",
    telephone: businessProfile.phone.e164,
    contactType: "customer service",
    email: businessProfile.email.public,
    areaServed: businessProfile.address.country,
    availableLanguage: ["English"],
  },
  foundingDate: businessProfile.founded,
  description: businessProfile.description.medium,
  sameAs: socialLinks,
};

// --- AI-search @graph ---
// Consolidated entity + site + speakable block targeting AI-powered search
// surfaces (Perplexity, SearchGPT, Google AI Overviews, Cloudflare AI Search
// / AutoRAG, Gemini). Cloudflare AI Search has no required schema — this
// block follows the cross-provider consensus shape: a @graph combining:
//   1. WebSite + SearchAction — so AI answers can deep-link to site search
//      (the urlTemplate is a hint to crawlers even when no search page
//      exists yet; when we ship /search the template points at it).
//   2. Organization enriched with knowsAbout / slogan / legalName / identifier
//      — AI crawlers use these to disambiguate the entity and build the
//      "what does this company do" answer.
//   3. SpeakableSpecification — tells voice and summarizing AIs which CSS
//      selectors carry the primary "answer" content on each page.
// Every node carries @id anchors so Google's parser treats duplicates
// (organization() from @1commerce/seo and this graph's Organization) as
// the same entity rather than competing declarations.
const aiSearchGraphLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${primaryUrl}/#website`,
      url: primaryUrl,
      name: businessProfile.display.name,
      alternateName: businessProfile.display.short_name,
      description: businessProfile.description.short,
      inLanguage: "en-US",
      publisher: { "@id": `${primaryUrl}/#organization` },
      potentialAction: {
        "@type": "SearchAction",
        target: {
          "@type": "EntryPoint",
          urlTemplate: `${primaryUrl}/?q={search_term_string}`,
        },
        "query-input": "required name=search_term_string",
      },
    },
    {
      "@type": "Organization",
      "@id": `${primaryUrl}/#organization`,
      name: businessProfile.legal.name,
      alternateName: [
        businessProfile.display.name,
        businessProfile.display.short_name,
      ],
      legalName: businessProfile.legal.name,
      url: primaryUrl,
      logo: {
        "@type": "ImageObject",
        "@id": `${primaryUrl}/#logo`,
        url: `${primaryUrl}/favicon.svg`,
        caption: businessProfile.display.name,
      },
      image: { "@id": `${primaryUrl}/#logo` },
      slogan: businessProfile.description.short,
      description: businessProfile.description.long,
      foundingDate: businessProfile.founded,
      // knowsAbout surfaces the topic areas the entity is authoritative on.
      // AI search engines index this heavily for "who is X" and "what
      // does X do" disambiguation.
      knowsAbout: [
        businessProfile.categories.primary,
        ...businessProfile.categories.secondary,
      ],
      // Mirror the identifiers LocalBusiness block carries so an AI crawler
      // that only reads this graph still gets the full NAP.
      address: {
        "@type": "PostalAddress",
        streetAddress: businessProfile.address.line_1,
        addressLocality: businessProfile.address.city,
        addressRegion: businessProfile.address.region,
        postalCode: businessProfile.address.postal_code,
        addressCountry: businessProfile.address.country,
      },
      contactPoint: {
        "@type": "ContactPoint",
        telephone: businessProfile.phone.e164,
        contactType: "customer service",
        email: businessProfile.email.public,
        areaServed: businessProfile.address.country,
        availableLanguage: ["English"],
      },
      sameAs: socialLinks,
    },
    {
      // SpeakableSpecification is attached to the WebSite node by reference.
      // cssSelector targets the per-page "answer" content — voice assistants
      // and AI summarizers read from these selectors when surfacing a
      // spoken or extractive answer.
      "@type": "SpeakableSpecification",
      "@id": `${primaryUrl}/#speakable`,
      cssSelector: ["h1", "main > section:first-of-type p", "[data-speakable]"],
    },
  ],
};

// Always emit Organization + WebSite + the NAP LocalBusiness block + the
// AI-search @graph; page-specific entries come via the jsonLd prop.
const allJsonLd = [
  organization(),
  website(),
  localBusinessLd,
  aiSearchGraphLd,
  ...jsonLd,
];

// Escape characters that could break out of the <script> tag or terminate
// JSON in line-separator contexts. JSON.stringify alone is NOT safe here.
function serializeJsonLd(entry: unknown): string {
  const json = JSON.stringify(entry);
  if (json === undefined) return "null";
  return json
    .replace(/</g, "\\u003c")
    .replace(/\u2028/g, "\\u2028")
    .replace(/\u2029/g, "\\u2029");
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{meta.title}</title>
    {
      meta.tags.map((t) =>
        t.name ? (
          <meta name={t.name} content={t.content} />
        ) : (
          <meta property={t.property} content={t.content} />
        )
      )
    }
    {meta.links.map((l) => <link {...l} />)}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <link rel="preconnect" href="https://neon.tech" crossorigin />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
    />
    {
      allJsonLd.map((entry) => (
        <script
          type="application/ld+json"
          set:html={serializeJsonLd(entry)}
        />
      ))
    }
  </head>
  <body class="min-h-screen flex flex-col">
    <Nav />
    <main class="flex-1"><slot /></main>
    <Footer />
  </body>
</html>
