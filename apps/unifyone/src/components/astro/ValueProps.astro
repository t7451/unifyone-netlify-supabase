---
const valueProps = [
  {
    title: "Contextual Financial AI",
    body: "Kai learns from your actual earnings, payouts, taxes, and fees — not generic budgeting rules. Every answer is grounded in your real numbers.",
  },
  {
    title: "Cross-Platform Gig Intelligence",
    body: "Uber, DoorDash, Instacart, Shopify, Stripe — one brain stitching together every stream so you see total take-home, not per-app silos.",
  },
  {
    title: "Developer-Grade AI Infrastructure",
    body: "REST endpoints, typed SDKs, and a usage-based credit ledger. Same engine Kai runs on is yours to build against.",
  },
];
---

<section class="bg-white py-20">
  <div class="max-w-6xl mx-auto px-4">
    <h2 class="text-3xl md:text-4xl font-bold text-navy-500 text-center">
      Why UnifyOne
    </h2>
    <div class="mt-12 grid md:grid-cols-3 gap-8">
      {
        valueProps.map((p) => (
          <article class="p-6 rounded-xl border border-navy-100 hover:border-teal-300 transition-colors">
            <h3 class="text-xl font-semibold text-navy-500">{p.title}</h3>
            <p class="mt-3 text-navy-400 leading-relaxed">{p.body}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
