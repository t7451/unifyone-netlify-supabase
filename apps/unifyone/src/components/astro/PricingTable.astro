---
interface Tier {
  name: string;
  price: string;
  cadence: string;
  tagline: string;
  features: string[];
  cta: { label: string; href: string };
  featured?: boolean;
}

const tiers: Tier[] = [
  {
    name: "Starter",
    price: "$0",
    cadence: "/month",
    tagline: "Kick the tires. Connect a platform, ask Kai 50 questions.",
    features: [
      "1 connected platform",
      "50 Kai credits / month",
      "Community Discord",
      "Basic deductions tracker",
    ],
    cta: { label: "Start free", href: "/sign-up" },
  },
  {
    name: "Pro",
    price: "$19",
    cadence: "/month",
    tagline: "For gig workers and freelancers running it as a business.",
    features: [
      "Unlimited platforms",
      "1,500 Kai credits / month",
      "Tax-ready exports",
      "Custom categorization rules",
      "Priority email support",
    ],
    cta: { label: "Start 14-day trial", href: "/sign-up" },
    featured: true,
  },
  {
    name: "Scale",
    price: "$99",
    cadence: "/month",
    tagline: "Teams, SMBs, and devs who need higher throughput + API.",
    features: [
      "Everything in Pro",
      "10,000 Kai credits / month",
      "API + webhook access",
      "Team seats (up to 5)",
      "SSO (coming soon)",
    ],
    cta: { label: "Talk to sales", href: "/sign-up" },
  },
];
---

<section class="bg-white py-20">
  <div class="max-w-6xl mx-auto px-4">
    <h2 class="text-3xl md:text-4xl font-bold text-navy-500 text-center">
      Simple pricing
    </h2>
    <p class="mt-4 text-navy-400 text-center max-w-2xl mx-auto">
      Every plan includes Kai, full platform connectors, and the same core
      intelligence. Pick the volume that fits.
    </p>

    <div class="mt-12 grid md:grid-cols-3 gap-6">
      {
        tiers.map((t) => (
          <article
            class={`rounded-2xl border p-8 flex flex-col ${
              t.featured
                ? "border-teal-400 ring-2 ring-teal-100 bg-gradient-to-b from-teal-50 to-white"
                : "border-navy-100"
            }`}
          >
            {t.featured && (
              <span class="inline-block self-start bg-gold-400 text-navy-500 text-xs font-bold uppercase tracking-wider px-2 py-1 rounded mb-3">
                Most popular
              </span>
            )}
            <h3 class="text-xl font-bold text-navy-500">{t.name}</h3>
            <div class="mt-3 flex items-baseline gap-1">
              <span class="text-4xl font-bold text-navy-500">{t.price}</span>
              <span class="text-navy-400 text-sm">{t.cadence}</span>
            </div>
            <p class="mt-3 text-sm text-navy-400">{t.tagline}</p>
            <ul class="mt-6 space-y-3 flex-1">
              {t.features.map((f) => (
                <li class="flex items-start gap-2 text-sm text-navy-500">
                  <span class="text-teal-400 font-bold">✓</span>
                  <span>{f}</span>
                </li>
              ))}
            </ul>
            <a
              href={t.cta.href}
              class={`mt-8 text-center py-3 rounded-md font-semibold transition-colors ${
                t.featured
                  ? "bg-teal-400 hover:bg-teal-500 text-white"
                  : "bg-navy-500 hover:bg-navy-400 text-white"
              }`}
            >
              {t.cta.label}
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>
