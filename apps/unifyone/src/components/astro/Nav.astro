---
const links = [
  { href: "/gig-workers", label: "Gig workers" },
  { href: "/freelancers", label: "Freelancers" },
  { href: "/smb", label: "SMB" },
  { href: "/developers", label: "Developers" },
  { href: "/pricing", label: "Pricing" },
  { href: "/blog", label: "Blog" },
];
---

<header class="border-b border-navy-100 bg-white/95 backdrop-blur sticky top-0 z-40">
  <nav class="max-w-6xl mx-auto px-4 h-16 flex items-center justify-between">
    <a href="/" class="flex items-center gap-2 font-semibold text-navy-500">
      <img src="/favicon.svg" alt="" width="28" height="28" />
      UnifyOne
    </a>
    <ul class="hidden md:flex items-center gap-6 text-sm">
      {
        links.map((l) => (
          <li>
            <a
              href={l.href}
              class="text-navy-400 hover:text-teal-400 transition-colors"
            >
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
    <div class="flex items-center gap-3">
      <a
        href="https://1commerce.online/login"
        class="text-sm text-navy-400 hover:text-teal-400 transition-colors"
      >
        Sign in
      </a>
      <a
        href="https://1commerce.online/signup"
        class="text-sm bg-teal-400 hover:bg-teal-500 text-white px-4 py-2 rounded-md font-medium transition-colors"
      >
        Get started
      </a>
    </div>
  </nav>
</header>
