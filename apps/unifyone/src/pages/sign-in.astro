---
import Base from "../layouts/Base.astro";
import { SignIn } from "@clerk/astro/components";
import { canonical } from "../lib/seo";
---

<Base
  title="Sign in — UnifyOne"
  description="Sign in to UnifyOne."
  canonicalUrl={canonical("/sign-in")}
>
  <section class="min-h-[70vh] flex items-center justify-center py-16 bg-navy-50">
    <SignIn
      path="/sign-in"
      signUpUrl="/sign-up"
      fallbackRedirectUrl="/"
    />
  </section>
</Base>
