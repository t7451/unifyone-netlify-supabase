---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";
import { canonical } from "../../lib/seo";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf()
);
---

<Base
  title="Blog — UnifyOne"
  description="Product updates, technical writeups, and field notes on contextual financial AI."
  canonicalUrl={canonical("/blog")}
>
  <section class="max-w-3xl mx-auto px-4 py-16">
    <h1 class="text-4xl md:text-5xl font-bold text-navy-500">Blog</h1>
    <p class="mt-3 text-navy-400">
      Product updates, technical writeups, field notes.
    </p>

    <ul class="mt-12 space-y-8">
      {
        posts.map((p) => (
          <li class="border-b border-navy-100 pb-8 last:border-0">
            <a
              href={`/blog/${p.slug}`}
              class="block group"
            >
              <h2 class="text-2xl font-semibold text-navy-500 group-hover:text-teal-500 transition-colors">
                {p.data.title}
              </h2>
              <p class="mt-2 text-navy-400">{p.data.description}</p>
              <p class="mt-3 text-xs text-navy-300 uppercase tracking-wider">
                <time datetime={p.data.publishedAt.toISOString()}>
                  {p.data.publishedAt.toISOString().slice(0, 10)}
                </time>
                {" · "}
                {p.data.author}
              </p>
            </a>
          </li>
        ))
      }
      {
        posts.length === 0 && (
          <li class="text-navy-400">No posts yet — check back soon.</li>
        )
      }
    </ul>
  </section>
</Base>
