---
import Base from "../../layouts/Base.astro";
import { getCollection, type CollectionEntry } from "astro:content";
import { article, breadcrumb, canonical } from "../../lib/seo";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

type Props = { post: CollectionEntry<"blog"> };
const { post } = Astro.props as Props;
const { Content } = await post.render();

const url = canonical(`/blog/${post.slug}`);
const wordCount = post.body.trim().split(/\s+/).length;
const readingMinutes = Math.max(1, Math.ceil(wordCount / 220));

const articleJsonLd = article({
  title: post.data.title,
  description: post.data.description,
  slug: post.slug,
  publishedAt: post.data.publishedAt,
  updatedAt: post.data.updatedAt,
  author: post.data.author,
  coverImage: post.data.coverImage,
});

const bc = breadcrumb([
  { name: "Home", url: canonical("/") },
  { name: "Blog", url: canonical("/blog") },
  { name: post.data.title, url },
]);
---

<Base
  title={`${post.data.title} — UnifyOne`}
  description={post.data.description}
  canonicalUrl={url}
  ogImage={post.data.coverImage}
  type="article"
  jsonLd={[articleJsonLd, bc]}
>
  <article class="max-w-3xl mx-auto px-4 py-16">
    <p class="text-xs text-navy-300 uppercase tracking-wider">
      <time datetime={post.data.publishedAt.toISOString()}>
        {post.data.publishedAt.toISOString().slice(0, 10)}
      </time>
      {" · "}
      {post.data.author}
      {" · "}
      {readingMinutes} min read
    </p>
    <h1 class="mt-3 text-4xl md:text-5xl font-bold text-navy-500">
      {post.data.title}
    </h1>
    <p class="mt-4 text-lg text-navy-400">{post.data.description}</p>
    <div class="prose prose-navy mt-10 max-w-none text-navy-500 leading-relaxed [&_h2]:text-2xl [&_h2]:font-bold [&_h2]:mt-8 [&_h2]:mb-3 [&_p]:my-4 [&_a]:text-teal-500 [&_a:hover]:underline [&_ul]:list-disc [&_ul]:pl-6 [&_ul]:my-4 [&_li]:my-1 [&_code]:bg-navy-50 [&_code]:px-1 [&_code]:rounded">
      <Content />
    </div>
  </article>
</Base>
