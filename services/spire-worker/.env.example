# --- Neon (shared with apps/spire-admin) ---
NEON_DATABASE_URL=

# --- DataForSEO (rank cron) ---
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# --- Resend (email submissions) ---
# Separate sending domain from MailerLite marketing — put submissions on
# reach.unifyone.com with its own DKIM/SPF/DMARC.
RESEND_API_KEY=
RESEND_FROM=submissions@reach.unifyone.com

# --- Encryption ---
# 32-byte hex string. Encrypts Playwright storage state at rest in
# spire_directories.method_config.storage_state_encrypted.
# Generate with: openssl rand -hex 32
STORAGE_STATE_ENCRYPTION_KEY=

# --- Tuning ---
WORKER_SLEEP_SECONDS=60
# Rank cron wakeup: cron-style 5-field UTC. Default = Mondays at 06:00 UTC.
RANK_CRON=0 6 * * 1
LOG_LEVEL=info
